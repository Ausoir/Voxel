[sub_resource type="Shader" id="Shader_lbe5x"]
code = "shader_type spatial;
render_mode unshaded;

uniform sampler2D noisemap;
uniform vec4 base_color : source_color;
uniform vec4 tip_color : source_color;

uniform float timescale = 1.0;
uniform float fire_aperture : hint_range( 0.0, 3.0 ) = 0.22;

void vertex(){
	NORMAL = vec3(0.0, 1.0, 0.0);
	MODELVIEW_MATRIX = VIEW_MATRIX * mat4(vec4(normalize(cross(vec3(0.0, 1.0, 0.0), INV_VIEW_MATRIX[2].xyz)), 0.0), vec4(0.0, 1.0, 0.0, 0.0), vec4(normalize(cross(INV_VIEW_MATRIX[0].xyz, vec3(0.0, 1.0, 0.0))), 0.0), MODEL_MATRIX[3]);
}

void fragment( )
{
	vec2 center_dist = UV - .5;
	float rad = max(0., 1. - abs(length(center_dist)) - .5);
	vec2 uv_shift = UV + vec2( 0, TIME * timescale );
	float rand = texture( noisemap, uv_shift ).r;
	float noise = rad * ( ( ( rad + fire_aperture ) * rand - fire_aperture ) * 400.0 );
	vec4 final_color = mix( tip_color.rgba, base_color.rgba, noise * 0.05 );

	ALBEDO = final_color.rgb;
	EMISSION = final_color.rgb;
	ALPHA = clamp( noise, 0.0, 1.0 );
}"

